#!/usr/bin/env bash
# After a commit that adds/removes/renames a skill or agent entrypoint, re-install
# for ALL detected hosts (Claude + Codex) so local symlinks stay in sync without a
# manual install step. Runs post-commit so it never blocks or slows the commit.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

git rev-parse --verify HEAD~1 >/dev/null 2>&1 || exit 0

if git diff --name-only HEAD~1 HEAD | grep -qE '^(skills|agents)/'; then
  echo "blaude-bode: skill/agent entrypoints changed; installing (all detected hosts)"
  ./install.sh >/dev/null || echo "blaude-bode: install skipped (claude/codex not on PATH)"
fi
