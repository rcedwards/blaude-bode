#!/usr/bin/env bash
# Registration changes and agent edits need installation after the commit, once
# tracked paths reflect the new skill/agent set. Skill body edits were built by
# pre-commit and reach Codex through the installed skill symlinks.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# diff-tree --root also handles a repository's first commit.
git diff-tree --root --no-commit-id --name-status -r HEAD | .githooks/lib/refresh-codex-artifacts --install-only || {
  echo "blaude-bode: refresh failed; run ./install.sh by hand" >&2
}
