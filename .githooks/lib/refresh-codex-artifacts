#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
cd "$REPO_ROOT"

matches_codex_source() {
  local path="$1"

  case "$path" in
    agents/*|skills/*|build.sh|bin/lib/frontmatter.sh)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

matches_installed_entrypoint() {
  local path="$1"

  case "$path" in
    agents/*/AGENT.md|skills/*/SKILL.md)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

needs_refresh=false
needs_install=false

while IFS=$'\t' read -r status path extra_path; do
  [[ -n "${status:-}" ]] || continue

  if [[ -z "${path:-}" ]]; then
    path="$status"
    status=""
  fi

  final_path="${extra_path:-$path}"

  if matches_codex_source "$path" || matches_codex_source "$final_path"; then
    needs_refresh=true
  fi

  case "$status" in
    A|D|R*|C*)
      if matches_installed_entrypoint "$path" || matches_installed_entrypoint "$final_path"; then
        needs_install=true
      fi
      ;;
  esac
done

if $needs_install && [[ "${1:-}" == --install* ]]; then
  echo "blaude-bode: skill/agent entrypoints changed; installing (all detected hosts)"
  if ! install_out="$(./install.sh 2>&1)"; then
    echo "blaude-bode: install failed; run ./install.sh by hand (if sandboxed, escalate). Last output:"
    printf '%s\n' "$install_out" | tail -n 5 | sed 's/^/  /'
  fi
elif $needs_refresh && [[ "${1:-}" != --install-only ]]; then
  echo "blaude-bode: refreshing generated Codex artifacts"
  if ./build.sh >/dev/null; then
    echo "blaude-bode: Codex artifacts refreshed"
  else
    echo "blaude-bode: build failed; run ./build.sh by hand" >&2
  fi
fi
